DB_CLASS_NAME=your_sql_driver
DB_URL=user_db_url
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_SECRET=your_google_secret

MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_pin_16

# 32자 이상 임의 문자열 (필수)
JWT_SECRET=change_me_to_random_string_at_least_32_chars

# 관리자가 한 명도 없을 때만 서버 기동 시 1회 생성
ADMIN_INIT_ID=admin
ADMIN_INIT_EMAIL=admin@skincare.ai
ADMIN_INIT_PASSWORD=change_me
ADMIN_INIT_NAME=관리자

# AI 서버 기본 주소(경로 제외)와 Bearer 인증 토큰 (설계서 10.3.11)
AI_SERVICE_URL=yourt_ai_service_url
AI_SERVICE_TOKEN=your_ai_service_token

# 업로드 사진 저장 폴더
FILE_UPLOAD_DIR=./uploads

# 공공데이터포털 인증키는 따옴표 없이 입력
EMERGENCY_API_URL=http://apis.data.go.kr/B552657/ErmctInfoInqireService/getEgytListInfoInqire
API_SERVICE_KEY=your_public_data_service_key

CORS_ALLOWED_ORIGINS=http://localhost:5173
