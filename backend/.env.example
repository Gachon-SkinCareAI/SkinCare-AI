# For direct MySQL startup: apply versioned schema first. The local runner supplies these automatically.
SPRING_PROFILES_ACTIVE=mysql
DB_CLASS_NAME=com.mysql.cj.jdbc.Driver
DB_URL=jdbc:mysql://127.0.0.1:13306/skincare_dev?sslMode=REQUIRED&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=skincare_app
DB_PASSWORD=replace_with_your_database_password

GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# User authentication does not use email delivery.
MAIL_USERNAME=
MAIL_PASSWORD=
# Required: generate a unique secret of at least 32 UTF-8 bytes. No default signing key.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes

AI_BASE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=replace_with_the_same_private_token_as_the_ai_server

# Social-only user authentication. Leave pairs empty until provider registration is ready.
# Google uses a Web application OAuth client. Kakao uses its REST API key + enabled client secret.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
SOCIAL_PUBLIC_BASE_URL=http://127.0.0.1:9800
SOCIAL_REDIRECT_URIS=http://127.0.0.1:8081/,http://localhost:8081/,skincareai://oauth/callback

# Public medical directory: decoded data.go.kr key, server-only. Empty disables external search.
PUBLIC_MEDICAL_SERVICE_KEY=
# Approved optional training notice (HTTPS); empty blocks opt-in, not withdrawal.
TRAINING_POLICY_URL=
# Verified clinical reviewer ADMIN IDs, comma-separated. Empty denies clinical approval.
SKINCARE_CLINICAL_REVIEWERS=

# Required published policy documents, shared by server and app. Empty blocks new consent.
TERMS_POLICY_URL=
PRIVACY_POLICY_URL=
