{
  "expo": {
    "name": "SkinCare AI",
    "slug": "skincare-auth",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "상처 사진 촬영을 위해 카메라 접근이 필요합니다.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "상처 사진 선택을 위해 사진에 접근합니다.",
          "cameraPermission": "상처 사진 촬영을 위해 카메라 접근이 필요합니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "동의한 경우 주변 병원·약국을 검색할 때 현재 위치를 사용합니다."
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "scheme": "skincareai"
  }
}
