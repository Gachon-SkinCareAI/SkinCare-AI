{
    admin off
    auto_https off
}

:80 {
    request_body {
        max_size 9MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    route {
        import /run/secrets/gateway_caddy
        # Auto-deploy status (public, no secrets). Under /api/wc/ because the Cloudflare
        # Worker only forwards a fixed list of /download/ files. Before forward_auth so it
        # stays readable while a deploy is restarting the backend.
        @deployStatus {
            method GET HEAD
            path /api/wc/deploy-status
        }
        handle @deployStatus {
            root * /srv/distribution
            rewrite * /deploy-status.json
            header Content-Type "application/json; charset=utf-8"
            header Cache-Control "no-store"
            file_server
        }
        forward_auth maintenance:9100 {
            uri /ready?
            header_up -Authorization
            header_up -Cookie
            header_up -X-SkinCare-Gateway
            transport http {
                dial_timeout 1s
                response_header_timeout 12s
            }
        }
        @private path /api/v1/* /swagger* /v3/api-docs* /actuator* /api/wc/policy-previews/*
        respond @private 404
        redir /download /download/ 302
        @download {
            method GET HEAD
            path /download/ /download/index.html /download/SkinCare-AI.apk /download/install-qr.png /download/release.json
        }
        handle @download {
            uri strip_prefix /download
            root * /srv/distribution
            header Cache-Control "no-store"
            file_server
        }
        @otherDownload path /download/*
        respond @otherDownload 404
        reverse_proxy backend:9800 {
            header_up -Forwarded
            header_up -X-SkinCare-Gateway
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {$PUBLIC_HOST}
            header_up X-Forwarded-Port 443
            transport http {
                response_header_timeout 90s
            }
        }
    }
}
